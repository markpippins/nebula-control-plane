# nebula-control-plane runtime mode
#   mock = serve seeded in-memory data on port 3000 (default — no .env file needed)
#   live = proxy all /api requests to nebula-srv:3101 on port 4014
VITE_NCP_MODE=mock

# Override the backend target when VITE_NCP_MODE=live
# VITE_NCP_TARGET=http://localhost:3101

# Override the default port (mock=3000, live=4014)
# PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
